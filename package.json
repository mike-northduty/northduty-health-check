{
  "name": "northduty-health-check",
  "version": "1.0.0",
  "description": "Website health checker: HTTP status, SSL, DNS, redirects, Core Web Vitals, JavaScript errors and blank-page detection with Playwright",
  "main": "index.js",
  "bin": {
    "northduty-health-check": "./index.js"
  },
  "scripts": {
    "check": "node index.js",
    "worker": "node worker.js",
    "start": "node worker.js",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:browsers": "playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-northduty/northduty-health-check.git"
  },
  "homepage": "https://northduty.com",
  "bugs": {
    "url": "https://github.com/mike-northduty/northduty-health-check/issues"
  },
  "keywords": [
    "website-monitoring",
    "health-check",
    "uptime",
    "ssl-checker",
    "web-vitals",
    "playwright",
    "url-checker"
  ],
  "author": "NorthDuty (https://northduty.com)",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1019.0",
    "axe-core": "^4.10.3",
    "dotenv": "^17.3.1",
    "playwright": "^1.58.2",
    "tldts": "^7.4.2",
    "whois-json": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.8.5"
  }
}
